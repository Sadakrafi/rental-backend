# MongoDB Atlas Connection URI (Required in production on Vercel)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/rentalDB?retryWrites=true&w=majority

# Nodemailer Gmail Notification Credentials (Optional)
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_gmail_app_password

# Port for local development
PORT=5000

# Environment
NODE_ENV=development
